# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vitest/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. `.env.development` holds public development defaults and is
# committed; local overrides go in `.env.development.local`.
.env*
!.env.example
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client generated by `npm run db:generate`
/src/generated

# Third-party agent skills: restored from `skills-lock.json` with
# `npx skills experimental_install`. Skills written for this project stay
# tracked.
/.agents/skills/*
!/.agents/skills/fix-text-overflow/

# Vendor-specific AI assistant files stay local: the repository only carries
# the tool-neutral `AGENTS.md` and `.agents/skills/`. Only the most common
# tools are listed; ignore any other in your global ignore file
# (`git config --global core.excludesFile`).
/.claude/
/CLAUDE.md
/.cursor/
/.github/copilot-instructions.md
/.github/instructions/
/.github/prompts/
/.windsurf/

# documentation site (docs/), built by `npm run build` there
/docs/node_modules
/docs/dist
/docs/.astro

# desktop app (desktop/): `dist` is built by `npm run build` there, `release`
# by `npm run package` and `npm run flatpak`
/desktop/node_modules
/desktop/dist
/desktop/release

# Connection string for the PostgreSQL instance served by `compose.yaml`.
# The credentials and port match the defaults baked into that file, so no
# override is needed to get started. 127.0.0.1 is spelled out rather than
# "localhost" because rootless engines often resolve "localhost" to ::1 first,
# while the published port is bound on IPv4.
DATABASE_URL=postgresql://nutria:nutria@127.0.0.1:5432/nutria

# Credentials for `podman compose up -d`, should you want something other than
# the development defaults.
# POSTGRES_USER=nutria
# POSTGRES_PASSWORD=nutria
# POSTGRES_DB=nutria
# POSTGRES_PORT=5432

# Signs the session cookies. Required in production, and must stay the same
# across restarts or every session is invalidated. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret

# Public origin users open Nutria at, e.g. https://nutria.example.com behind a
# reverse proxy. Better Auth only accepts auth requests from this origin.
BETTER_AUTH_URL=http://localhost:3000

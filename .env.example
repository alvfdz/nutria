# Self-hosting configuration, read by `compose.yaml` only. Copy it to `.env`
# next to `compose.yaml`. Development does not use this file: see
# `.env.development`.

# Password of the PostgreSQL account Nutria uses. Required. It is set when the
# database volume is first created; changing it here later does not change it
# in an existing database. It goes into a connection URL unescaped, so avoid
# `@ / : #`. Generate one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs the session cookies. Required, and must stay the same across restarts
# or every session is invalidated. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin users open Nutria at, e.g. https://nutria.example.com behind a
# reverse proxy. Better Auth only accepts auth requests from this origin.
BETTER_AUTH_URL=http://localhost:3000

# Optional. Host port the app is published on; keep `BETTER_AUTH_URL` in step
# when you serve it directly rather than through a proxy.
# APP_PORT=3000

# Optional. Your time zone, which decides when "today" starts on the Today page
# and the calendar. Defaults to UTC.
# TZ=Europe/Madrid

# Optional. Name of the PostgreSQL account and database. Like the password,
# they are set when the database volume is first created.
# POSTGRES_USER=nutria
# POSTGRES_DB=nutria

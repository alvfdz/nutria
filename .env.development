# Development defaults, committed on purpose: `next dev`, the Prisma CLI and
# `scripts/` load this file, so a fresh checkout needs no configuration. None
# of these values are secret and none of them reach the container image.
# Override any of them in `.env.development.local` (gitignored).
#
# Self-hosting is configured separately, in `.env` (see `.env.example`).

# The database from `compose.dev.yaml`. 127.0.0.1 is spelled out rather than
# "localhost" because rootless engines often resolve "localhost" to ::1 first,
# while the published port is bound on IPv4.
DATABASE_URL=postgresql://nutria:nutria@127.0.0.1:5432/nutria

# Signs the session cookies. Public, so development-only.
BETTER_AUTH_SECRET=nutria-development-secret-do-not-use-in-production

# The origin `npm run dev` serves on.
BETTER_AUTH_URL=http://localhost:3000
